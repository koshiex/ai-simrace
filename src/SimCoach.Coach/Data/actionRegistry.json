{
  "schema_version": "actions/1",
  "actions": [
    {
      "id": "brake_later_by_meters",
      "label_short": "brake_later",
      "hint_en": "braked too early",
      "cadence": "corner",
      "priority": { "phase": "brake", "rank": 10 },
      "requires_reference": true,
      "when": [
        { "field": "brake_point_diff_m", "op": "lt", "value": -2.0 },
        { "field": "off_track", "op": "eq", "value": false }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" },
        { "name": "meters", "from": "brake_point_diff_m", "transform": "abs_round0", "unit": "м" }
      ],
      "phrase_template_ru": "В {corner} тормози позже на {meters}."
    },
    {
      "id": "more_trail_brake",
      "label_short": "more_trail",
      "hint_en": "too little trail braking",
