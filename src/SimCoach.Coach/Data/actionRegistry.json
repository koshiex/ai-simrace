{
  "schema_version": "actions/1",
  "actions": [
    {
      "id": "brake_later_by_meters",
      "label_short": "brake_later",
      "hint_en": "braked too early",
      "hint_ru": "тормозит слишком рано",
      "cadence": "corner",
      "priority": { "phase": "brake", "rank": 10 },
      "requires_reference": true,
      "when": [
        { "field": "brake_point_diff_m", "op": "lt", "value": -2.0 },
        { "field": "off_track", "op": "eq", "value": false }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" },
        { "name": "meters", "from": "brake_point_diff_m", "transform": "abs_round0", "unit": "м" }
      ],
      "phrase_template_ru": "В {corner} тормози позже на {meters}."
    },
    {
      "id": "brake_release_too_early",
      "label_short": "release_early",
      "hint_en": "released the brake too early before the apex",
      "hint_ru": "рано отпускает тормоз до апекса",
      "cadence": "corner",
      "priority": { "phase": "brake", "rank": 15 },
      "requires_reference": true,
      "when": [
        { "field": "brake_release_diff_m", "op": "lt", "value": -2.0 },
        { "field": "off_track", "op": "eq", "value": false }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" },
        { "name": "meters", "from": "brake_release_diff_m", "transform": "abs_round0", "unit": "м" }
      ],
      "phrase_template_ru": "В {corner} дольше держи тормоз к апексу — отпускаешь на {meters} раньше."
    },
    {
      "id": "more_trail_brake",
      "label_short": "more_trail",
      "hint_en": "too little trail braking",
      "hint_ru": "мало трейл-брейкинга к апексу",
      "cadence": "corner",
      "priority": { "phase": "brake", "rank": 11 },
      "requires_reference": true,
      "when": [
        { "field": "trail_brake_diff_pct", "op": "lt", "value": -0.1 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Дольше держи тормоз к апексу в {corner}."
    },
    {
      "id": "less_trail_brake",
      "label_short": "less_trail",
      "hint_en": "too much trail braking + oversteer",
      "hint_ru": "избыток трейл-брейкинга, занос",
      "cadence": "corner",
      "priority": { "phase": "brake", "rank": 12 },
      "requires_reference": true,
      "when": [
        { "field": "trail_brake_diff_pct", "op": "gt", "value": 0.1 },
        { "field": "oversteer_score", "op": "gt", "value": 0.35 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Меньше тормоза в {corner}, отпускай раньше."
    },
    {
      "id": "straighter_braking",
      "label_short": "straighter",
      "hint_en": "braking while steering",
      "hint_ru": "тормозит с повёрнутым рулём",
      "cadence": "corner",
      "priority": { "phase": "brake", "rank": 13 },
      "requires_reference": false,
      "when": [
        { "field": "brake_overlap_steer_pct", "op": "gt", "value": 0.5 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Не тормози в {corner}, выпрямляй руль."
    },
    {
      "id": "overdrove_entry",
      "label_short": "overdrove",
      "hint_en": "overdrove entry, low min speed",
      "hint_ru": "перебор на входе, низкая мин. скорость",
      "cadence": "corner",
      "priority": { "phase": "entry", "rank": 20 },
      "requires_reference": true,
      "when": [
        { "field": "brake_point_diff_m", "op": "gt", "value": 2.0 },
        { "field": "min_speed_diff_kmh", "op": "lt", "value": -3.0 },
        { "field": "off_track", "op": "eq", "value": false }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Перебираешь на входе в {corner}, тормози раньше."
    },
    {
      "id": "wider_entry",
      "label_short": "wider_entry",
      "hint_en": "understeer + low min speed",
      "hint_ru": "снос и низкая мин. скорость",
      "cadence": "corner",
      "priority": { "phase": "entry", "rank": 21 },
      "requires_reference": true,
      "when": [
        { "field": "understeer_score", "op": "gt", "value": 0.35 },
        { "field": "min_speed_diff_kmh", "op": "lt", "value": -3.0 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Шире вход в {corner}, неси скорость."
    },
    {
      "id": "lift_partial_throttle",
      "label_short": "lift",
      "hint_en": "carrying too much entry speed",
      "hint_ru": "слишком высокая скорость на входе",
      "cadence": "corner",
      "priority": { "phase": "entry", "rank": 22 },
      "requires_reference": true,
      "when": [
        { "field": "min_speed_diff_kmh", "op": "gt", "value": 4.0 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Чуть сбрось газ на входе в {corner}."
    },
    {
      "id": "smoother_steering",
      "label_short": "smoother",
      "hint_en": "jerky steering input",
      "hint_ru": "резкие движения рулём",
      "cadence": "corner",
      "priority": { "phase": "entry", "rank": 23 },
      "requires_reference": false,
      "when": [
        { "field": "steering_jitter", "op": "gt", "value": 0.15 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Плавнее руль в {corner}."
    },
    {
      "id": "tighten_entry",
      "label_short": "tighten_entry",
      "hint_en": "entry line wider than the reference line",
      "hint_ru": "вход шире эталонной линии",
      "cadence": "corner",
      "priority": { "phase": "entry", "rank": 24 },
      "requires_reference": true,
      "when": [
        { "field": "entry_line_deviation_m", "op": "gt", "value": 0.5 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Плотнее вход в {corner}."
    },
    {
      "id": "open_entry",
      "label_short": "open_entry",
      "hint_en": "entry line tighter than the reference line",
      "hint_ru": "вход уже эталонной линии",
      "cadence": "corner",
      "priority": { "phase": "entry", "rank": 25 },
      "requires_reference": true,
      "when": [
        { "field": "entry_line_deviation_m", "op": "lt", "value": -0.5 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Шире заход в {corner}."
    },
    {
      "id": "ease_understeer",
      "label_short": "ease_understeer",
      "hint_en": "strong understeer (no reference)",
      "hint_ru": "сильный снос (без эталона)",
      "cadence": "corner",
      "priority": { "phase": "apex", "rank": 30 },
      "requires_reference": false,
      "when": [
        { "field": "understeer_score", "op": "gt", "value": 0.45 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Снос в {corner}: плавнее руль, меньше скорости на входе."
    },
    {
      "id": "higher_min_speed",
      "label_short": "higher_min_speed",
      "hint_en": "low minimum speed",
      "hint_ru": "низкая минимальная скорость",
      "cadence": "corner",
      "priority": { "phase": "apex", "rank": 31 },
      "requires_reference": true,
      "when": [
        { "field": "min_speed_diff_kmh", "op": "lt", "value": -3.0 },
        { "field": "off_track", "op": "eq", "value": false }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Быстрее по минимуму в {corner}, не лифти."
    },
    {
      "id": "tighten_apex",
      "label_short": "tighten_apex",
      "hint_en": "wide of the apex line",
      "hint_ru": "широко от апекса",
      "cadence": "corner",
      "priority": { "phase": "apex", "rank": 32 },
      "requires_reference": true,
      "when": [
        { "field": "racing_line_deviation_m", "op": "gt", "value": 0.5 },
        { "field": "min_speed_diff_kmh", "op": "lt", "value": 0.0 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Ближе к апексу в {corner}."
    },
    {
      "id": "settle_oversteer",
      "label_short": "settle_oversteer",
      "hint_en": "oversteer on exit (no reference)",
      "hint_ru": "занос на выходе (без эталона)",
      "cadence": "corner",
      "priority": { "phase": "exit", "rank": 40 },
      "requires_reference": false,
      "when": [
        { "field": "oversteer_score", "op": "gt", "value": 0.35 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Занос в {corner}: мягче газ, успокой машину."
    },
    {
      "id": "tighten_exit",
      "label_short": "tighten_exit",
      "hint_en": "exit line wider than the reference line",
      "hint_ru": "выход шире эталонной линии",
      "cadence": "corner",
      "priority": { "phase": "exit", "rank": 43 },
      "requires_reference": true,
      "when": [
        { "field": "exit_line_deviation_m", "op": "gt", "value": 0.5 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Плотнее выход из {corner}."
    },
    {
      "id": "open_exit",
      "label_short": "open_exit",
      "hint_en": "not using the exit line width",
      "hint_ru": "не добираешь ширину на выходе",
      "cadence": "corner",
      "priority": { "phase": "exit", "rank": 44 },
      "requires_reference": true,
      "when": [
        { "field": "exit_line_deviation_m", "op": "lt", "value": -0.5 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Раскрывай выход из {corner}, шире."
    },
    {
      "id": "wheelspin_on_exit",
      "label_short": "wheelspin",
      "hint_en": "wheelspin on exit",
      "hint_ru": "пробуксовка на выходе",
      "cadence": "corner",
      "priority": { "phase": "exit", "rank": 41 },
      "requires_reference": false,
      "when": [
        { "field": "wheelspin_score", "op": "gt", "value": 0.3 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Меньше газа на выходе из {corner}, ловишь пробуксовку."
    },
    {
      "id": "brake_lockup",
      "label_short": "lockup",
      "hint_en": "locking the front wheels under braking",
      "hint_ru": "блокирует передние колёса при торможении",
      "cadence": "corner",
      "priority": { "phase": "brake", "rank": 16 },
      "requires_reference": false,
      "when": [
        { "field": "brake_lockup_score", "op": "gt", "value": 0.4 },
        { "field": "off_track", "op": "eq", "value": false }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "В {corner} мягче на тормоз в начале — блокируешь передние колёса."
    },
    {
      "id": "short_shift",
      "label_short": "short_shift",
      "hint_en": "upshifting below the power band",
      "hint_ru": "переключаешься вверх слишком рано, ниже полки мощности",
      "cadence": "corner",
      "priority": { "phase": "exit", "rank": 45 },
      "requires_reference": false,
      "when": [
        { "field": "short_shift_score", "op": "gt", "value": 0.4 },
        { "field": "off_track", "op": "eq", "value": false }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "На выходе из {corner} держи передачу дольше — переключаешься слишком рано."
    },
    {
      "id": "earlier_throttle",
      "label_short": "earlier_throttle",
      "hint_en": "late to throttle on exit",
      "hint_ru": "поздно открывает газ на выходе",
      "cadence": "corner",
      "priority": { "phase": "exit", "rank": 42 },
      "requires_reference": true,
      "when": [
        { "field": "throttle_resume_diff_m", "op": "lt", "value": -3.0 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Раньше газ на выходе из {corner}."
    },
    {
      "id": "ran_wide",
      "label_short": "ran_wide",
      "hint_en": "ran wide / off track (no reference)",
      "hint_ru": "вышел за пределы трассы (без эталона)",
      "cadence": "corner",
      "priority": { "phase": "apex", "rank": 33 },
      "requires_reference": false,
      "when": [
        { "field": "off_track", "op": "eq", "value": true }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Широко в {corner}, вышел за пределы — держи трассу."
    },
    {
      "id": "trail_brake_absent",
      "label_short": "no_trail",
      "hint_en": "almost no trail braking (absolute, no reference)",
      "hint_ru": "почти нет трейл-брейкинга (без эталона)",
      "cadence": "corner",
      "priority": { "phase": "brake", "rank": 14 },
      "requires_reference": false,
      "when": [
        // had-braking gate: peak_brake_pct > 0.1 means the driver actually braked in this window (the same
        // 0.10 brake floor the trail-brake denominator uses). Without it a flat/lift-only corner reports
        // trail_brake_pct_self=0 and would wrongly draw a "hold the brake longer" tip every lap.
        { "field": "peak_brake_pct", "op": "gt", "value": 0.1 },
        // provisional absolute threshold — owner ratifies the exact value later (M19)
        { "field": "trail_brake_pct_self", "op": "lt", "value": 0.05 }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" }
      ],
      "phrase_template_ru": "Мало трейл-брейкинга в {corner}, дольше держи тормоз к апексу."
    },
    {
      "id": "corner_catch_all",
      "label_short": "corner_loss",
      "hint_en": "notable corner time loss",
      "hint_ru": "заметная потеря времени в повороте",
      "cadence": "corner",
      "priority": { "phase": "exit", "rank": 900 },
      "requires_reference": true,
      // M21: name the cause (glossed reason) instead of a bare millisecond count; the `reason neq slower`
      // clause keeps the catch-all silent when the compute reason is empty/`slower` (a vague gloss adds
      // nothing over silence).
      "when": [
        { "field": "delta_ms", "op": "abs_gt", "value": 150.0 },
        { "field": "reason", "op": "neq", "value": "slower" }
      ],
      "params": [
        { "name": "corner", "from": "corner_name" },
        { "name": "reason", "from": "reason", "transform": "reason_ru" }
      ],
      "phrase_template_ru": "В {corner} теряешь: {reason}."
    },
    {
      "id": "sector_summary_loss",
      "label_short": "sector_loss",
      "hint_en": "losing time in this sector",
      "hint_ru": "теряет время в этом секторе",
      "cadence": "sector",
      "priority": { "phase": "exit", "rank": 300 },
      "requires_reference": true,
      "when": [
        { "field": "delta_ms", "op": "gt", "value": 100.0 }
      ],
      "params": [
        { "name": "loss", "from": "delta_ms", "transform": "abs_round0", "unit": "мс" },
        { "name": "top", "from": "top_corner" }
      ],
      "phrase_template_ru": "Теряешь {loss}, главное — {top}."
    },
    {
      "id": "sector_summary_gain",
      "label_short": "sector_gain",
      "hint_en": "gaining time in this sector",
      "hint_ru": "выигрывает время в этом секторе",
      "cadence": "sector",
      "priority": { "phase": "exit", "rank": 301 },
      "requires_reference": true,
      "when": [
        { "field": "delta_ms", "op": "lt", "value": -50.0 }
      ],
      "params": [
        { "name": "gain", "from": "delta_ms", "transform": "abs_round0", "unit": "мс" }
      ],
      "phrase_template_ru": "Выиграл {gain}, держи такой ритм."
    },
    {
      "id": "sector_keep_pushing",
      "label_short": "sector_ok",
      "hint_en": "sector on pace",
      "hint_ru": "сектор в графике",
      "cadence": "sector",
      "priority": { "phase": "exit", "rank": 302 },
      "requires_reference": true,
      "when": [
        { "field": "delta_ms", "op": "abs_lt", "value": 50.0 }
      ],
      "params": [],
      "phrase_template_ru": "Сектор в норме, продолжай."
    },
    {
      "id": "sector_catch_all",
      "label_short": "sector_summary",
      "hint_en": "large sector deviation",
      "hint_ru": "большое отклонение в секторе",
      "cadence": "sector",
      "priority": { "phase": "exit", "rank": 910 },
      "requires_reference": true,
      "when": [
        { "field": "delta_ms", "op": "abs_gt", "value": 200.0 }
      ],
      "params": [
        { "name": "loss", "from": "delta_ms", "transform": "abs_round0", "unit": "мс" }
      ],
      "phrase_template_ru": "В секторе отклонение около {loss}."
    },
    {
      "id": "lap_pb",
      "label_short": "lap_pb",
      "hint_en": "personal best lap",
      "hint_ru": "личный рекорд круга",
      "cadence": "lap",
      "priority": { "phase": "exit", "rank": 200 },
      "requires_reference": false,
      "when": [
        { "field": "is_pb", "op": "eq", "value": true }
      ],
      "params": [],
      "phrase_template_ru": "Личный рекорд! Так держать."
    },
    {
      "id": "lap_clean_focus",
      "label_short": "lap_focus",
      "hint_en": "clean but slower than reference",
      "hint_ru": "чисто, но медленнее эталона",
      "cadence": "lap",
      "priority": { "phase": "exit", "rank": 201 },
      "requires_reference": true,
      "when": [
        { "field": "is_clean", "op": "eq", "value": true },
        { "field": "delta_ms", "op": "gt", "value": 200.0 }
      ],
      "params": [
        { "name": "loss", "from": "delta_ms", "transform": "abs_round0", "unit": "мс" },
        { "name": "top", "from": "top_corner" }
      ],
      "phrase_template_ru": "Чисто, но на {loss} медленнее. Поработай над {top}."
    },
    {
      "id": "lap_dirty",
      "label_short": "lap_dirty",
      "hint_en": "invalid / dirty lap",
      "hint_ru": "грязный или невалидный круг",
      "cadence": "lap",
      "priority": { "phase": "exit", "rank": 202 },
      "requires_reference": false,
      "when": [
        { "field": "is_clean", "op": "eq", "value": false }
      ],
      "params": [],
      "phrase_template_ru": "Круг грязный. Не торопись, попробуй ещё раз."
    },
    {
      "id": "tyre_overheat",
      "label_short": "tyre_temp",
      "hint_en": "tyres overheating",
      "hint_ru": "перегрев резины",
      "cadence": "lap",
      "priority": { "phase": "exit", "rank": 203 },
      "requires_reference": false,
      "when": [
        { "field": "tyre_overheat", "op": "eq", "value": true }
      ],
      "params": [
        { "name": "temp", "from": "max_tyre_temp_c", "transform": "abs_round0", "unit": "°C" }
      ],
      "phrase_template_ru": "Перегрев резины, {temp}. Береги покрышки."
    },
    {
      "id": "brake_overheat",
      "label_short": "brake_temp",
      "hint_en": "brakes overheating",
      "hint_ru": "перегрев тормозов",
      "cadence": "lap",
      "priority": { "phase": "exit", "rank": 204 },
      "requires_reference": false,
      "when": [
        { "field": "brake_overheat", "op": "eq", "value": true }
      ],
      "params": [
        { "name": "temp", "from": "max_brake_temp_c", "transform": "abs_round0", "unit": "°C" }
      ],
      "phrase_template_ru": "Перегрев тормозов, {temp}. Дай им остыть."
    },
    {
      "id": "lap_catch_all",
      "label_short": "lap_summary",
      "hint_en": "large lap deviation",
      "hint_ru": "большое отклонение за круг",
      "cadence": "lap",
      "priority": { "phase": "exit", "rank": 905 },
      "requires_reference": true,
      "when": [
        { "field": "delta_ms", "op": "abs_gt", "value": 250.0 }
      ],
      "params": [
        { "name": "loss", "from": "delta_ms", "transform": "abs_round0", "unit": "мс" }
      ],
      "phrase_template_ru": "За круг отклонение около {loss}."
    }
  ]
}
