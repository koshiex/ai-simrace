<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SimCoach.Reference</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimCoach.Reference.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimCoach.Contracts\SimCoach.Contracts.csproj" />
    <ProjectReference Include="..\SimCoach.Pipeline\SimCoach.Pipeline.csproj" />
    <ProjectReference Include="..\SimCoach.Storage\SimCoach.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- First-party baked corner geometry, one file per track: cornerGeometry.<trackId>.json (ADR-0014). -->
    <EmbeddedResource Include="Data\cornerGeometry.*.json" />
    <!-- First-party baked median centerline, one file per track: centerline.<trackId>.json (ADR-0019, M38) —
         the runtime LINE reference loaded by CenterlineGeometryDataset. -->
    <EmbeddedResource Include="Data\centerline.*.json" />
  </ItemGroup>

</Project>
