<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SimCoach.Reference</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimCoach.Reference.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimCoach.Contracts\SimCoach.Contracts.csproj" />
    <ProjectReference Include="..\SimCoach.Pipeline\SimCoach.Pipeline.csproj" />
    <ProjectReference Include="..\SimCoach.Storage\SimCoach.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored per-track baked assets. LogicalName is pinned + WithCulture=false because a track whose id
         is a valid culture code (e.g. "spa" = ISO 639-2 Spanish) would otherwise be mistaken by MSBuild's
         AssignCulture for a satellite resource and silently dropped from the assembly — the manifest name is
         what the *Dataset loaders match on, so it must stay <RootNamespace>.Data.<file>. -->
    <!-- First-party baked corner geometry, one file per track: cornerGeometry.<trackId>.json (ADR-0014). -->
    <EmbeddedResource Include="Data\cornerGeometry.*.json">
      <LogicalName>SimCoach.Reference.Data.%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- First-party baked median centerline, one file per track: centerline.<trackId>.json (ADR-0019, M38) —
         the runtime LINE reference loaded by CenterlineGeometryDataset. -->
    <EmbeddedResource Include="Data\centerline.*.json">
      <LogicalName>SimCoach.Reference.Data.%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- Vendored alien racing-line reference, one LINE-only parquet per track: alien_line.<trackId>.parquet
         (ADR-0021, PR-B3) — loaded by AlienLineDataset. Monza is vendored; more tracks are added as their
         alien LINE is baked. -->
    <EmbeddedResource Include="Data\alien_line.*.parquet">
      <LogicalName>SimCoach.Reference.Data.%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

</Project>
