{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/SimCoach/logs/simcoach-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },

  "Telemetry": {
    "Source": "acc",
    "Replay": {
      "Path": "",
      "SpeedMultiplier": 1.0
    },
    "Ingest": {
      "SubscriberChannelCapacity": 256
    }
  },

  "Compute": {
    "ResumeThrottlePct": 0.5,
    "TopLossesCount": 3
  },

  "Coach": {
    "InCornerMaxWords": 8,
    "SectorMaxWords": 25,
    "LapMaxWords": 25,
    "DebriefMaxWords": 200,
    "Rules": {
      "SessionBudgetUsd": 0.50,
      "MonthlyBudgetUsd": 5.00,
      "Cadence": {
        "GlobalCooldown": "00:00:03",
        "MaxTipsPerLap": 5,
        "MinTimeLossMs": 100.0
      }
    }
  },

  "Llm": {
    "Live": false,
    "OfflineProviderId": "fake",
    "OfflineModelId": "fake/local",
    "Routes": {
      "corner":   { "ProviderId": "openrouter-google",    "ModelId": "google/gemini-3.1-flash-lite", "MaxOutputTokens": 96,   "Timeout": "00:00:02",     "Reasoning": "Off", "Temperature": 0, "TopP": 1.0 },
      "sector":   { "ProviderId": "openrouter-google",    "ModelId": "google/gemini-2.5-flash-lite", "MaxOutputTokens": 192,  "Timeout": "00:00:02.500", "Reasoning": "Off", "Temperature": 0, "TopP": 1.0 },
      "lap":      { "ProviderId": "openrouter-google",    "ModelId": "google/gemini-2.5-flash-lite", "MaxOutputTokens": 192,  "Timeout": "00:00:03",     "Reasoning": "Off", "Temperature": 0, "TopP": 1.0 },
      "debrief":  { "ProviderId": "openrouter-anthropic", "ModelId": "anthropic/claude-sonnet-4.6",  "MaxOutputTokens": 2000, "Timeout": "00:00:20",     "Reasoning": "Low", "Temperature": 0 },
      "strategy": { "ProviderId": "openrouter-google",    "ModelId": "google/gemini-2.5-flash-lite", "MaxOutputTokens": 192,  "Timeout": "00:00:03",     "Reasoning": "Off", "Temperature": 0, "TopP": 1.0 }
    },
    "Providers": {
      "openrouter-google": {
        "BaseUrl": "https://openrouter.ai/api/v1/",
        "AuthEnvVar": "OPENROUTER_API_KEY",
        "Rates": {
          "google/gemini-2.5-flash-lite": { "InputPerMillion": 0.10, "OutputPerMillion": 0.40, "CachedInputPerMillion": 0.05 },
          "google/gemini-3.1-flash-lite": { "InputPerMillion": 0.25, "OutputPerMillion": 1.50, "CachedInputPerMillion": 0.125 }
        }
      },
      "openrouter-anthropic": {
        "BaseUrl": "https://openrouter.ai/api/v1/",
        "AuthEnvVar": "OPENROUTER_API_KEY",
        "Rates": {
          "anthropic/claude-sonnet-4.6": { "InputPerMillion": 3.00, "OutputPerMillion": 15.00, "CachedInputPerMillion": 0.30 }
        }
      },
      "fake": {
        "BaseUrl": "https://fake.local/",
        "AuthEnvVar": "SIMCOACH_FAKE_UNUSED",
        "Rates": {
          "fake/local": { "InputPerMillion": 0.0, "OutputPerMillion": 0.0, "CachedInputPerMillion": 0.0 }
        }
      }
    },
    "CircuitBreaker": {
      "FailureThreshold": 3,
      "Window": "00:01:00",
      "BreakDuration": "00:01:00"
    }
  },

  "Voice": {
    "Backend": "silero",
    "Silero": {
      "ModelPath": "%LOCALAPPDATA%/SimCoach/models/v5_ru.onnx",
      "Voice": "aidar"
    },
    "Yandex": {
      "Enabled": false,
      "FolderId": "",
      "VoiceName": "filipp"
    }
  },

  "Overlay": {
    "RefreshHz": 30,
    "Opacity": 0.85,
    "RaceMode": false
  },

  "Storage": {
    "DataRoot": "%LOCALAPPDATA%/SimCoach",
    "McapRotateSeconds": 60,
    "RetentionDays": 90
  },

  "Database": {
    "DbPath": "%LOCALAPPDATA%/SimCoach/simcoach.db"
  }
}
