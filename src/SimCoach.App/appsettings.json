{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/SimCoach/logs/simcoach-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },

  "Telemetry": {
    "Sim": "acc",
    "TargetHz": 100
  },

  "Coach": {
    "BrakeEarlyMeters": 2.0,
    "BrakeLateMeters": 2.0,
    "MinSpeedDeltaKmh": 3.0,
    "TrailBrakeDeltaPct": 0.10,
    "RacingLineDeviationM": 0.5,
    "InCornerMaxWords": 8,
    "SectorMaxWords": 25,
    "LapMaxWords": 25,
    "DebriefMaxWords": 200
  },

  "Llm": {
    "Provider": "openrouter",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "Models": {
      "Corner":  "google/gemini-2.5-flash",
      "Sector":  "google/gemini-2.5-flash",
      "Lap":     "google/gemini-2.5-flash",
      "Session": "deepseek/deepseek-chat-v3.2"
    },
    "TimeoutMs": 8000,
    "RetryAttempts": 1
  },

  "Voice": {
    "Backend": "silero",
    "Silero": {
      "ModelPath": "%LOCALAPPDATA%/SimCoach/models/v5_ru.onnx",
      "Voice": "aidar"
    },
    "Yandex": {
      "Enabled": false,
      "FolderId": "",
      "VoiceName": "filipp"
    }
  },

  "Overlay": {
    "RefreshHz": 30,
    "Opacity": 0.85,
    "RaceMode": false
  },

  "Storage": {
    "DataRoot": "%LOCALAPPDATA%/SimCoach",
    "McapRotateSeconds": 60,
    "RetentionDays": 90
  }
}
